# ── Application ─────────────────────────────────────────────────
APP_NAME=Raccord
APP_SERVICE=raccord
APP_ENV=local
APP_KEY=
# Former keys still accepted to read cookies, sessions and signed links made before a key rotation (comma separated).
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
# Reverse proxies in front of the installation (IP addresses or CIDR ranges, comma separated); empty when none.
TRUSTED_PROXIES=
# Extra host names answered besides the APP_URL host and its sub-domains (comma separated).
TRUSTED_HOSTS=
# Switches the whole installation off (every page answers 503 with a generic notice).
PLATFORM_ENABLED=true
APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Company ─────────────────────────────────────────────────────
# Company calendar: what "today" is for the planning, absences and the day punch.
COMPANY_TIMEZONE=Europe/Paris
# Initial administrator, created by the base seeder when the installation has none (password change forced at first sign-in).
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Logging ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days the security log (sign-in failures, client accounts, role changes…) is kept.
LOG_SECURITY_DAYS=365

# ── Database ────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# ── Session, cache, queue and files ─────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Map and address lookup ──────────────────────────────────────
# GEOCODER_DRIVER: nominatim (OpenStreetMap, worldwide, default) or address-fr (French national address API, France only).
GEOCODER_DRIVER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# Countries a town may be in (the ones that have a map in resources/maps).
GEOCODER_COUNTRIES=fr,pt,es,ua
GEOCODER_TIMEOUT=8
# Days an answer is kept, and the maximum number of answers kept per cache.
GEOCODER_CACHE_DAYS=180
GEOCODER_CACHE_MAX_ENTRIES=50000

# ── Day punch ───────────────────────────────────────────────────
# Months a GPS position (day punches, vehicle photos) is kept (the times and photos are kept), and the link used to open a position.
PUNCH_LOCATION_RETENTION_MONTHS=12
MAPS_LINK="https://www.google.com/maps?q=:lat,:lng"
# Accuracy (metres) above which managers see a warning next to a position (the punch is never refused).
PUNCH_LOCATION_ACCURACY_WARNING_METRES=200

# ── Retention of personal data ──────────────────────────────────
# Months after a departure before the personal documents are erased and before the account is anonymised.
DEPARTED_USER_DOCUMENTS_MONTHS=3
DEPARTED_USER_ANONYMISATION_MONTHS=12
# Days the « Logs » journal keeps changes, and days presences on audit boxes are kept.
ACTIVITY_LOG_RETENTION_DAYS=730
AUDIT_PRESENCE_RETENTION_DAYS=7
# Days the AI usage counter keeps its rows (the quotas only need the current day and hour).
AI_USAGE_RETENTION_DAYS=90

# ── Files and deleted records ───────────────────────────────────
# Days deleted records stay recoverable before being erased (0: kept forever); hours before an unused stored file is removed.
DELETED_RECORDS_RETENTION_DAYS=365
ORPHAN_FILES_GRACE_HOURS=48
# Free space (MB) under which official dossiers are no longer generated and the closure tab warns.
DOSSIER_MIN_FREE_MEGABYTES=2048
# Hand stored files to nginx (X-Accel-Redirect) instead of reading them in PHP; needs the internal location in nginx.
FILES_X_ACCEL_REDIRECT=false
FILES_X_ACCEL_PREFIX=/internal-files

# ── Audits ──────────────────────────────────────────────────────
# Operator codes accepted at the end of a box name, comma separated (the « JD » straight-joint suffix is always accepted).
AUDIT_BOX_SUFFIXES=
# Lines (besides a « 12 FO » cable line) that end the description of a box in the synoptic text, comma separated.
AUDIT_SYNOPTIC_STOP_PREFIXES=

# ── AI (Anthropic) ──────────────────────────────────────────────
# Reads equipment labels and receipts, compares vehicle photos, drafts occurrence texts (design office, also switched on in the settings). Leave the key empty to switch the AI off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Requests per day (UTC), per person and for the whole installation: receipts, equipment labels, vehicle photos, inventory photos, occurrence drafts.
AI_QUOTA_RECEIPT_USER=60
AI_QUOTA_RECEIPT_GLOBAL=400
AI_QUOTA_EQUIPMENT_USER=60
AI_QUOTA_EQUIPMENT_GLOBAL=400
AI_QUOTA_VEHICLE_USER=30
AI_QUOTA_VEHICLE_GLOBAL=200
AI_QUOTA_INVENTORY_USER=30
AI_QUOTA_INVENTORY_GLOBAL=150
AI_QUOTA_OCCURRENCE_USER=40
AI_QUOTA_OCCURRENCE_GLOBAL=200
# Requests per person within the last hour.
AI_QUOTA_RECEIPT_USER_HOUR=30
AI_QUOTA_EQUIPMENT_USER_HOUR=30
AI_QUOTA_VEHICLE_USER_HOUR=15
AI_QUOTA_INVENTORY_USER_HOUR=15
AI_QUOTA_OCCURRENCE_USER_HOUR=20

# ── Front end ───────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
