{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom", "dom.iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["node"]
    },
    "include": ["resources/js/**/*.ts", "tests/js/**/*.ts", "tests/browser/**/*.ts", "playwright.config.ts"]
}
